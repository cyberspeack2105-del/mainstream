MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?appName=<app-name>
MONGODB_DATABASE=electric

# Initial OWNER account. This must be a bcrypt hash, never a plain-text password.
ADMIN_USERNAME=owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-hash

# Generate at least 32 random characters and keep this secret on the server only.
ADMIN_SESSION_SECRET=replace-with-a-long-random-server-secret

# Copy this template to .env.local and put a newly generated key there.
# Never put a real key in this example file or expose it with NEXT_PUBLIC_.
MSE_OPENROUTER_API_KEY=
